rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{col}/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid
        && col in ['conversations', 'memories', 'notes', 'reminders'];
      allow create, update: if request.auth != null && request.auth.uid == uid
        && col in ['conversations', 'memories', 'notes', 'reminders']
        && request.resource.data.keys().size() <= 12
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 5000));
    }
  }
}
